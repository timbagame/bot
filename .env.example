# Telegram Coinflip Bot - Environment Variables

# Telegram bot token from @BotFather (required)
TELEGRAM_TOKEN=

# Mnemonic (seed phrase) for the bot's Solana wallet (required)
# Never use a mainnet wallet or real funds in development.
MNEMONIC=

# Solana RPC endpoint (required)
# Common options:
# - https://api.devnet.solana.com
# - https://api.testnet.solana.com
# - https://api.mainnet-beta.solana.com (use with caution)
SOLANA_NETWORK=https://api.devnet.solana.com

# Oracle API base URL (optional; defaults to http://localhost:3001)
# Used by the bot to request random hashes and stats from the oracle service.
ORACLE_API_URL=http://localhost:3001

