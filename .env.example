# Telegram Coinflip Bot - Environment Variables

# Telegram bot token from @BotFather (required)
TELEGRAM_TOKEN=

# Production reads the mnemonic from ./secrets/bot-mnemonic (mode 400 or 600).
# MNEMONIC remains supported only for local development and tests.

# Solana RPC endpoints (required). Provide a JSON array or comma-separated list
# ordered by preference; the bot automatically falls back when an endpoint fails.
# Common options:
# - https://api.mainnet-beta.solana.com (production)
# - https://api.devnet.solana.com (testing)
# - https://api.testnet.solana.com
SOLANA_NETWORK=["https://api.mainnet-beta.solana.com","https://rpc-backup.example.com"]

# Deployed Timba program ABI. Keep 0.2.0 until the coordinated contract upgrade.
CONTRACT_VERSION=0.2.0

# Optional overrides for the default game token (detected automatically otherwise)
# DEFAULT_TOKEN_MINT=
# DEFAULT_TOKEN_TICKER=

# Oracle API base URL (optional; defaults to http://localhost:3001)
# Used by the bot to request random hashes and stats from the oracle service.
# Inside Podman, use the oracle service name on the shared private network.
ORACLE_API_URL=http://oracle:3001

# Required shared secret for authenticated bot-to-oracle requests.
# Generate with: openssl rand -hex 32
# Production reads this from ./secrets/oracle-api-token (mode 400 or 600).

# Optional: Set this to your Solana address to opt into Helius backrun rebates
# when calling `sendTransaction` through a Helius mainnet RPC endpoint.
HELIUS_REBATE_ADDRESS=

# Jupiter API Key (required for api.jup.ag)
# Get one from https://portal.jup.ag
JUPITER_API_KEY=
