{
  "name": "timba-bot",
  "imports": {
    "#solana": "./src/utils/solana.ts",
    "#token": "./src/utils/token-kit.ts"
  },
  "scripts": {
    "service-admin": "bun run scripts/service-admin.ts",
    "start": "bun run src/bot.ts",
    "dev": "bun run --watch src/bot.ts",
    "audit": "bun -e 'if (Date.now() >= Date.parse(\"2026-11-23T00:00:00Z\")) { console.error(\"Audit exception GHSA-3gc7-fjrx-p6mg expired on 2026-11-23\"); process.exit(1); }' && bun audit --ignore GHSA-3gc7-fjrx-p6mg",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/commands": "^1.4.0",
    "@grammyjs/runner": "^2.0.3",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana-program/token-2022": "0.16.1",
    "@solana/kit": "8.2.0",
    "@solana/web3.js": "3.0.0-rc.3",
    "@timbagame/protocol": "0.12.1",
    "bip39": "^3.1.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "grammy": "^1.46.0",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "packageManager": "bun@1.4.2"
}
