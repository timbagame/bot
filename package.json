    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.5.0",
    "@solana/web3.js": "3.0.2",
    "@timbagame/protocol": "0.14.2",
    "bip39": "^3.1.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "grammy": "^1.46.0",
    "qrcode": "^1.5.4",
    "viem": "2.57.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "uuid": "14.0.3"
  },
  "packageManager": "bun@1.4.3"
