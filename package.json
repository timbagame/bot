{
  "name": "timba-bot",
  "scripts": {
    "service-admin": "bun run scripts/service-admin.ts",
    "start": "bun run src/bot.ts",
    "dev": "bun run --watch src/bot.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anchor-lang/core": "1.1.2",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/commands": "^1.3.2",
    "@grammyjs/runner": "^2.0.3",
    "@jup-ag/referral-sdk": "^0.3.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "bn.js": "^5.2.5",
    "grammy": "^1.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
