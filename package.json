{
  "name": "timba-bot",
  "scripts": {
    "service-admin": "bun run scripts/service-admin.ts",
    "start": "bun run src/bot.ts",
    "dev": "bun run --watch src/bot.ts",
    "audit": "bun -e 'if (Date.now() >= Date.parse(\"2026-11-23T00:00:00Z\")) { console.error(\"Audit exception GHSA-3gc7-fjrx-p6mg expired on 2026-11-23\"); process.exit(1); }' && bun audit --ignore GHSA-3gc7-fjrx-p6mg",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anchor-lang/core": "1.1.2",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/commands": "^1.4.0",
    "@grammyjs/runner": "^2.0.3",
    "@jup-ag/referral-sdk": "^0.3.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@timbagame/protocol": "0.2.1",
    "bip39": "^3.1.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "grammy": "^1.45.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
