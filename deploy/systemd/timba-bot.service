[Unit]
Description=Timba bot (rootless Podman)
Wants=network-online.target timba-oracle.service
After=network-online.target timba-oracle.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/timba/bot
ExecStartPre=-/usr/bin/podman network create timba
ExecStart=/usr/bin/podman compose -f compose.yml up -d
ExecReload=/usr/bin/podman compose -f compose.yml pull
ExecReload=/usr/bin/podman compose -f compose.yml up -d
ExecStop=/usr/bin/podman compose -f compose.yml down
TimeoutStartSec=0
TimeoutStopSec=90

[Install]
WantedBy=default.target
