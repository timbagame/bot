# Copy without .example only after creating the directory and protected secret files.
[Container]
Environment=FIXEDFLOAT_ENABLED=true
Environment=FIXEDFLOAT_API_KEY_FILE=/run/secrets/fixedfloat_api_key
Environment=FIXEDFLOAT_API_SECRET_FILE=/run/secrets/fixedfloat_api_secret
Environment=FIXEDFLOAT_DATABASE_FILE=/app/lightning/deposits.sqlite
Volume=%h/timba/bot/secrets/fixedfloat-api-key:/run/secrets/fixedfloat_api_key:ro,Z
Volume=%h/timba/bot/secrets/fixedfloat-api-secret:/run/secrets/fixedfloat_api_secret:ro,Z
Volume=%h/timba/bot/lightning:/app/lightning:Z
